# 세션 쿠키 서명과 인증 코드 해시용 비밀 값
# 생성 방식: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 쿠키의 Secure 옵션. 로컬 http 개발은 0, 배포(https)는 1
COOKIE_SECURE=0

# DB
# 루트에서 실행되는 시드 명령에 따라 생성되는 DB와 backend/에서 실행되는 서버 명령에 따른 DB 경로가 갖도록 설정
DB_PATH=../data/app.db
# 생성: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DB_SECRET_KEY=

# 인증 메일 발송 (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 개발 전용(선택): 이 사용자 id로 로그인한 것처럼 동작 (flask --debug일 때만)
# DEV_FAKE_USER_ID=

# OPENAI_API_KEY=
